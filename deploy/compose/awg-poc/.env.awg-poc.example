# Пример конфигурации PoC Этапа 0 (issue #257). РЕАЛЬНЫЙ .env.awg-poc генерируется
# ./gen-keys.sh (ключи Curve25519 + PSK) и НЕ коммитится (см. .gitignore). Здесь —
# только структура и плейсхолдеры для понимания набора переменных.

# --- Версии исходников AmneziaWG ---
AWG_GO_REF=master
AWG_TOOLS_REF=master

# --- Ключи пиров (awg genkey / awg pubkey / awg genpsk) ---
AWG_CLIENT_PRIVATE_KEY=<awg genkey>
AWG_CLIENT_PUBLIC_KEY=<awg pubkey клиента>
AWG_SERVER_PRIVATE_KEY=<awg genkey>
AWG_SERVER_PUBLIC_KEY=<awg pubkey сервера>
AWG_PRESHARED_KEY=<awg genpsk>

# --- Профиль обфускации (H1–H4 общие для обеих сторон, Jc/S* значимы на клиенте) ---
AWG_JC=6
AWG_JMIN=40
AWG_JMAX=70
AWG_S1=0
AWG_S2=0
AWG_H1=<uint32 >4>
AWG_H2=<uint32 >4>
AWG_H3=<uint32 >4>
AWG_H4=<uint32 >4>
AWG_MTU=1380

# --- Прикладной слой C9 (снимается на Этапе 2, Q2) ---
EDGE_VPN_SESSION_KEY=<base64 32 байта>
EDGE_VPN_EDGE_ID=edge-rf
EDGE_VPN_EDGE_CERT=edge-rf-poc-cert
EDGE_VPN_APP_ID=app-core
EDGE_VPN_APP_CERT=app-core-poc-cert

# --- Параметры пробы ---
C9_PROBE_CONTENT_BYTES=1300000
C9_PROBE_CONNECT_TIMEOUT_MS=60000
