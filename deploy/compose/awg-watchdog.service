# systemd-юнит watchdog AWG-туннеля (стабилизация, авто-перезапуск awg-server/-client).
#
# Стенд (оба кластера на одном хосте) — role=both (дефолт):
#   sudo cp deploy/compose/awg-watchdog.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now awg-watchdog
#
# Прод (кластеры на РАЗНЫХ хостах) — ставьте роль под хост через systemctl edit
# или отдельные drop-in Environment=:
#   app-хост:  AWG_WATCHDOG_ROLE=app   REPO=/root/git/bridge
#   edge-хост: AWG_WATCHDOG_ROLE=edge  REPO=/home/ubuntu/git/bridge
#              AWG_RF_ENV_FILES="--env-file /home/ubuntu/git/bridge/.env.rf"
#              AWG_RF_UP_FLAGS=--no-build   # на edge сборка запрещена (память)
# Правьте REPO/роль/интервалы под окружение.
[Unit]
Description=Bridge AWG tunnel watchdog (auto-restart awg-server/awg-client)
After=docker.service
Requires=docker.service

[Service]
Type=simple
Environment=REPO=/root/git/bridge
Environment=AWG_WATCHDOG_ROLE=both
Environment=AWG_WATCHDOG_INTERVAL=30
Environment=AWG_MAX_HANDSHAKE_AGE=180
ExecStart=/bin/bash -c '${REPO}/deploy/compose/awg-watchdog.sh loop'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
