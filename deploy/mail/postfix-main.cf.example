# Anti-abuse / rate-limit переопределения Postfix для docker-mailserver (Этап M4).
#
# Скопируйте в deploy/mail/config/postfix-main.cf (bind-конфиг) — docker-mailserver
# подхватит эти строки как переопределения main.cf при старте/перезапуске:
#   cp deploy/mail/postfix-main.cf.example deploy/mail/config/postfix-main.cf
#   docker restart <mailserver>
#
# ДВА УРОВНЯ защиты от превращения услуги в спам-релей:
#   1. anvil (ниже) — ПОКЛИЕНТНЫЕ (по IP) лимиты. Грубый предохранитель: весь
#      внутренний трафик идёт с ОДНОГО IP edge-gateway, поэтому anvil лимитирует
#      суммарный поток с этого IP, а не отдельный ящик. Держите его выше суммы
#      легитимной нагрузки всех менеджеров — иначе throttlит всех разом.
#   2. postfwd (deploy/mail/postfwd.cf.example) — per-user/per-org лимиты по
#      ОТПРАВИТЕЛЮ (sasl_username/домен) + suspend. Это основной контроль злоупотреблений;
#      подключается к submission через check_policy_service (рецепт запуска и
#      подключения — deploy/mail/README.md §M4). anvil его не заменяет.

# Максимальный размер письма (25 MiB).
message_size_limit = 26214400

# --- anvil: поклиентные (по IP) лимиты, окно 60s ---------------------------
anvil_rate_time_unit = 60s
# Подключений с одного клиента за окно.
smtpd_client_connection_rate_limit = 60
# Писем с одного клиента за окно. Держите с запасом над пиком edge-gateway
# (суммарно по всем менеджерам), т.к. это ОДИН IP; тонкий per-ящик срез — postfwd.
smtpd_client_message_rate_limit = 600
# Получателей (адресатов) с одного клиента за окно.
smtpd_client_recipient_rate_limit = 2000
# Одновременных подключений с одного клиента.
smtpd_client_connection_count_limit = 40
# Ошибок/новых адресов с одного клиента за окно (грубый анти-scan предохранитель).
smtpd_client_new_tls_session_rate_limit = 60

# --- postfwd policy hook ---------------------------------------------------
# Per-user/per-org лимиты и suspend делает postfwd (postfwd.cf.example), а не
# main.cf: он должен стоять в submission-цепочке (587/465), чтобы лимитировать
# ОТПРАВКУ клиентов, а не входящий MX. Подключение — через -o в postfix-master.cf
# (см. postfix-master.cf.example), НЕ глобальным smtpd_*_restrictions здесь, иначе
# перетрётся managed-цепочка docker-mailserver. Рецепт запуска postfwd и его
# подключения к submission (postconf -P) — deploy/mail/README.md §M4. Подключайте
# только ПОСЛЕ запуска postfwd, иначе submission начнёт падать в 451 (policy-
# сервис недоступен).

# --- (Опционально) Ужесточение TLS для исходящего relay (Этап M3) ---
# docker-mailserver при заданном RELAY_HOST уже включает SASL и STARTTLS. Если
# relay ТОЛЬКО через транзакционный SMTP (прямой доставки по MX нет), можно
# потребовать шифрование ко всем исходящим — раскомментируйте:
#   smtp_tls_security_level = encrypt
# ВНИМАНИЕ: `encrypt` сломает прямую доставку по MX на серверы без TLS. Если
# используется и relay, и прямая доставка — оставьте дефолт `may` (оппортунистич.).
