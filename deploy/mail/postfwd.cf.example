#############################################################################
# postfwd — политика лимитов ОТПРАВКИ «Bridge Mail» (per-user / per-org + suspend)
# Этап M4, docs/plan/mail-service-selfhosted.md §M4.
#
# Зачем postfwd, а не только anvil: per-IP anvil-лимиты (postfix-main.cf.example)
# не различают отправителей — весь внутренний трафик идёт с ОДНОГО IP
# edge-gateway, поэтому «100 писем/мин с клиента» throttlит всех менеджеров разом
# и не ловит один зарвавшийся ящик. postfwd лимитирует по ОТПРАВИТЕЛЮ
# (sasl_username = адрес ящика, которым аутентифицируется edge-gateway при
# submission) и по домену организации — это и есть per-user/per-org контроль.
#
# Модель адресов (см. план §M2): в MVP один ящик на организацию на общем
# MAIL_DOMAIN, поэтому per-mailbox == per-org. Домен-на-организацию (мультидомен,
# M3/M5) — тогда включается per-domain-правило ниже.
#
# ВКЛючение: запустить postfwd с этим ruleset и подключить его к Postfix через
# check_policy_service (см. postfix-main.cf.example и deploy/mail/README.md §M4).
# Значения — стартовые боевые; правьте под тариф услуги.
#
# ПРЕДПОСЫЛКА: submission должен быть аутентифицирован (edge-gateway ходит с
# SMTP AUTH под кредами ящика → sasl_username выставлен). Для неаутентифицированного
# relay из docker-сети (PERMIT_DOCKER=connected-networks) sasl_username пуст —
# такой трафик ловит fallback по client_address; в проде PERMIT_DOCKER стоит
# ужесточить, чтобы submission всегда шёл через AUTH.
#############################################################################

#--- 0. Suspend по злоупотреблению (высший приоритет) -----------------------
# Приостановленные ящики/домены — жёсткий REJECT. Списки — по одному значению в
# строке; управление — deploy/mail/mail-suspend.sh (add/del). Пустой файл =
# правило не срабатывает (нет совпадений).
id=SUSPEND_USER
  sasl_username=file:/etc/postfwd/suspended-senders.cf
  action=REJECT учётная запись приостановлена за злоупотребление; обратитесь в поддержку

id=SUSPEND_SENDER
  sender=file:/etc/postfwd/suspended-senders.cf
  action=REJECT учётная запись приостановлена за злоупотребление; обратитесь в поддержку

#--- 1. Per-mailbox (== per-org в MVP) лимиты по числу писем -----------------
# Ключ rate() — sasl_username (адрес ящика). Формат: rate(ключ/лимит/окно_сек/ответ).
# При превышении postfwd возвращает ответ Postfix (450 = временный отказ, клиент
# повторит позже; замените на REJECT для жёсткого среза).
id=USER_RATE_HOUR
  sasl_username=~/^.+$/
  action=rate(sasl_username/200/3600/450 4.7.1 rate limit: не более 200 писем/час с ящика)

id=USER_RATE_DAY
  sasl_username=~/^.+$/
  action=rate(sasl_username/2000/86400/450 4.7.1 rate limit: не более 2000 писем/сутки с ящика)

#--- 2. Ограничение веера получателей ---------------------------------------
# Слишком много получателей в одном письме — типичный признак спам-рассылки.
id=USER_RCPT_PER_MSG
  sasl_username=~/^.+$/
  recipient_count=50
  action=REJECT 5.7.1 слишком много получателей в одном письме (макс. 50)

# Суммарный поток получателей в сутки с ящика (rcpt() считает получателей).
id=USER_RCPT_DAY
  sasl_username=~/^.+$/
  action=rcpt(sasl_username/5000/86400/450 4.7.1 rate limit: превышен суточный лимит получателей с ящика)

#--- 3. Fallback для неаутентифицированного relay из docker-сети ------------
# Если sasl_username пуст (submission без AUTH), лимитируем по IP-источнику,
# чтобы скомпрометированный внутренний клиент не стал открытым релеем.
id=NOAUTH_RATE
  sasl_username=~/^$/
  action=rate(client_address/500/3600/450 4.7.1 rate limit: неаутентифицированный источник)

#--- 4. (Мультидомен) per-org лимит по домену-отправителю -------------------
# Раскомментируйте на стадии «домен-на-организацию» (M3/M5): лимитирует суммарную
# отправку организации, владеющей доменом, поверх per-mailbox-правил выше.
#id=ORG_DOMAIN_RATE_DAY
#  sender=~/@(?<dom>[^@]+)$/
#  action=rate(sender_domain/10000/86400/450 4.7.1 rate limit: суточный лимит организации (домен))

#--- Хвост: остальное пропускаем -------------------------------------------
id=DEFAULT
  action=DUNNO
