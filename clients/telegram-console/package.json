{
  "name": "@bridge/telegram-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc -p tsconfig.json",
    "test": "find test -name '*.test.ts' -print0 | xargs -0 -r node --import tsx --test",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/main.ts"
  }
}
