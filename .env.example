# Bridge SaaS — переменные окружения для Application Cluster
# (deploy/compose/docker-compose.yml).
#
# Скопируйте этот файл в .env и при необходимости отредактируйте:
#   cp .env.example .env
#   docker compose --env-file .env -f deploy/compose/docker-compose.yml up --build
#
# Флаг --env-file обязателен: без него docker compose ищет .env рядом с
# файлом compose (deploy/compose/), а не в корне репозитория.
#
# Для отдельного РФ Edge-кластера используйте .env.rf.example —
# это полностью независимая конфигурация (deploy/compose/docker-compose.rf.yml).

# --- PostgreSQL (Application Cluster) ---
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge
POSTGRES_DB=bridge
POSTGRES_PORT=5432

# Строка подключения, которую использует backend и джобы migrate/seed.
# ВАЖНО: docker compose не разворачивает вложенные подстановки переменных,
# поэтому если вы меняете POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB выше —
# обновите и эту строку вручную. Хост "postgres" — имя сервиса в сети
# compose, его менять не нужно.
DATABASE_URL=postgres://bridge:bridge@postgres:5432/bridge

# Подробный лог миграций node-pg-migrate. Скрипт сравнивает значение строго
# со строкой "1" — включайте так: DB_MIGRATE_VERBOSE=1 (не true/false).
DB_MIGRATE_VERBOSE=0

# --- backend (core, NestJS) ---
BACKEND_PORT=3000

# Секрет хеширования сессий и одноразовых кодов входа (HMAC-SHA256). ОБЯЗАТЕЛЬНО
# замените на собственное случайное значение перед любым запуском, отличным
# от локальной разовой проверки, например:
#   openssl rand -hex 32
# compose пробрасывает это значение в backend как AUTH_HASH_SECRET — именно эту
# переменную читает код авторизации (сессии и коды входа через Telegram).
BRIDGE_AUTH_SECRET=change-me-to-a-random-secret

# --- Авторизация через Telegram (login/telegram/start + verify) ---
# Токен бота из @BotFather. Если задан — backend отправляет одноразовый код
# входа адресату через Telegram Bot API (sendMessage). Если пусто — код
# генерируется и API работает, но наружу не отправляется (режим локальной
# разработки/CI; код можно получить только из журналов backend).
# Получить токен: напишите @BotFather команду /newbot и следуйте инструкциям.
# Важно: Bot API не умеет писать приватному пользователю по @username — в users
# должен быть заполнен числовой telegram_id/chat_id. Если telegram_id пустой,
# backend оставляет best-effort fallback через getUpdates; он не работает при
# включённом webhook (HTTP 409) и не заменяет хранение users.telegram_id.
TELEGRAM_BOT_TOKEN=
# Базовый URL Telegram Bot API. Меняйте только для self-hosted прокси/эмулятора.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- ai-platform (SVC-AI, RAG-пайплайн) ---
AI_PLATFORM_PORT=3006
# URL backend, по которому ai-platform обращается к базе знаний.
# Если меняете BACKEND_PORT — обновите и этот URL вручную.
AI_BACKEND_KB_URL=http://backend:3000

# --- integration-platform (приём сообщений внешних платформ) ---
INTEGRATION_PLATFORM_PORT=3005
# URL, по которому integration-platform передаёт входящие сообщения в ядро.
# Если меняете BACKEND_PORT — обновите и этот URL вручную.
CORE_INGRESS_URL=http://backend:3000/internal/ingress/messages
# URL, по которому backend передаёт исходящие сообщения (C2.EgressDelivery) в
# integration-platform для доставки во внешний канал. Если переменная пустая,
# backend фиксирует статус исходящего сообщения (routed→sent) только в БД, но
# наружу его не пересылает (осознанная деградация для локальной разработки/CI).
INTEGRATION_EGRESS_URL=http://integration-platform:3005/internal/egress/deliveries

# --- broadcast-platform ---
BROADCAST_PLATFORM_PORT=3008

# --- notification-platform ---
NOTIFICATION_PLATFORM_PORT=3010

# --- mobile-api ---
MOBILE_API_PORT=3015
# Базовый URL Edge Cluster для мобильных клиентов РФ (CP-7, ТЗ §7.6). Если задан —
# mobile-api отдаёт клиентам маршрут через Edge и заголовок C9-туннеля
# (x-bridge-edge-tunnel: mobile) в /config и /health. Пусто/не задан — прямой режим.
# EDGE_BASE_URL=https://edge.rf.bridge.local/mobile/v1

# --- fbp-engine ---
FBP_ENGINE_PORT=3095

# --- Фронтенды (Vite, раздаются через "vite preview") ---
SAAS_ADMIN_PORT=8081
MANAGER_WORKSPACE_PORT=8082
WEB_CHAT_PORT=8083

# URL backend, который saas-admin и manager-workspace проксируют на "/api"
# при старте vite preview. Если меняете BACKEND_PORT — обновите и это значение.
BACKEND_INTERNAL_URL=http://backend:3000
