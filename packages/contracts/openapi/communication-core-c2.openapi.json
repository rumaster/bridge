{
  "openapi": "3.1.0",
  "info": {
    "title": "Communication Core C2 Ingress/Egress",
    "version": "1.0.0",
    "description": "Internal INT <-> CORE contract for adapter ingress, persisted routing, and channel-aware delivery dispatch."
  },
  "paths": {
    "/internal/ingress/messages": {
      "post": {
        "operationId": "acceptIngressMessage",
        "summary": "Adapter -> Core ingress for canonical C1 messages.",
        "tags": ["C2 Ingress"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngressMessageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Message accepted, persisted, and routed by Communication Core M1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngressAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid C1/C2 message DTO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/delivery/dispatch": {
      "post": {
        "operationId": "dispatchEgressDelivery",
        "summary": "Core -> Integration Platform delivery dispatch with channel-aware adapters.",
        "tags": ["C2 Egress"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../json-schema/c2-egress-delivery.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Delivery dispatch accepted by the Integration Platform.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryDispatchAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid egress DTO.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CanonicalMessage": {
        "$ref": "../message-model/message.schema.json"
      },
      "IngressMessageRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CanonicalMessage"
          }
        ],
        "description": "Canonical C1 message with direction=inbound and status=received."
      },
      "IngressAcceptedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "message_id",
          "idempotency_key",
          "organization_id",
          "conversation_id",
          "endpoint_id",
          "sequence_number",
          "status",
          "received_at",
          "routed_at",
          "routed_to"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          },
          "duplicate": {
            "type": "boolean"
          },
          "message_id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "endpoint_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence_number": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "const": "routed"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "routed_at": {
            "type": "string",
            "format": "date-time"
          },
          "routed_to": {
            "type": "string",
            "const": "manager"
          }
        }
      },
      "DeliveryDispatchAcceptedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "queued",
          "delivered",
          "duplicate",
          "status",
          "idempotency_key",
          "message_id",
          "adapter"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "queued": {
            "type": "boolean"
          },
          "delivered": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "external_message_id": {
            "type": ["string", "null"]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "errors"],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
