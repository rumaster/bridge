{
  "openapi": "3.1.0",
  "info": {
    "title": "Bridge C3.auth API",
    "version": "1.0.0",
    "description": "Frozen M1 contract for Identity Platform Telegram one-time code authentication and server sessions."
  },
  "x-contract-id": "C3.auth",
  "x-owner": "SVC-IDN",
  "x-stage": "M1",
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and current-session endpoints."
    }
  ],
  "paths": {
    "/auth/login/telegram/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "startTelegramLogin",
        "summary": "Start Telegram login",
        "description": "Accepts a platform user Telegram username, creates a one-time login challenge, stores only code_hash with TTL and schedules delivery through the M1 mock Telegram channel.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramLoginStartRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Login challenge accepted by the M1 delivery flow.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelegramLoginStartResponse"
                }
              }
            }
          },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "429": {
          "$ref": "#/components/responses/TooManyRequests"
        }
        }
      }
    },
    "/auth/login/telegram/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "verifyTelegramLogin",
        "summary": "Verify Telegram login code",
        "description": "Accepts a Telegram login requestId or username plus one-time code, verifies code_hash in constant time, consumes login_codes and creates a server auth session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelegramLoginVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated server session context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "summary": "Logout current session",
        "description": "Revokes the current server auth session by setting revoked_at.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Server session revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "getCurrentSession",
        "summary": "Get current session",
        "description": "Returns the current user, organization and roles for an active, not expired and not revoked server session.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current server session context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque M1 server session token. The backend stores only token_hash."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bridge_session",
        "description": "HTTP-only M1 server session cookie. The backend stores only token_hash."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "DTO validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required or the session is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit or brute-force lockout rejected the request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "TelegramLoginStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "telegramUsername"
        ],
        "properties": {
          "telegramUsername": {
            "type": "string",
            "minLength": 5,
            "maxLength": 33,
            "pattern": "^@?[A-Za-z0-9_]{5,32}$",
            "description": "Telegram username with optional @ prefix. Backend normalizes it to lowercase without @."
          }
        }
      },
      "TelegramLoginStartResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "delivery",
          "deliveryChannel",
          "telegramUsername",
          "requestId",
          "expiresAt",
          "expiresInSeconds",
          "implementationStage"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "code_delivery_scheduled"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": [
              "telegram"
            ]
          },
          "deliveryChannel": {
            "type": "string",
            "enum": [
              "telegram"
            ]
          },
          "telegramUsername": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "One-time login challenge id. It identifies the stored login_codes row without exposing the code."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresInSeconds": {
            "type": "integer",
            "minimum": 1,
            "example": 300
          },
          "implementationStage": {
            "type": "string",
            "enum": [
              "M1"
            ]
          }
        }
      },
      "TelegramLoginVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "anyOf": [
          {
            "required": [
              "requestId"
            ]
          },
          {
            "required": [
              "telegramUsername"
            ]
          }
        ],
        "properties": {
          "telegramUsername": {
            "type": "string",
            "minLength": 5,
            "maxLength": 33,
            "pattern": "^@?[A-Za-z0-9_]{5,32}$",
            "description": "Telegram username with optional @ prefix. Backend normalizes it to lowercase without @."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "One-time login challenge id returned by startTelegramLogin."
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Six-digit one-time code from Telegram. Backend verifies only code_hash and marks the challenge consumed."
          }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authenticated",
          "token",
          "expiresAt",
          "user",
          "organization",
          "roles",
          "roleBindings",
          "session",
          "implementationStage"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "token": {
            "type": "string",
            "description": "Opaque server session token. The database stores only token_hash."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "organization": {
            "$ref": "#/components/schemas/AuthOrganization"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthRoleCode"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthRoleBinding"
            }
          },
          "session": {
            "$ref": "#/components/schemas/AuthSession"
          },
          "implementationStage": {
            "type": "string",
            "enum": [
              "M1"
            ]
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "telegramUsername",
          "displayName",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "telegramUsername": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AuthRoleCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked"
            ]
          }
        }
      },
      "AuthOrganization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked"
            ]
          }
        }
      },
      "AuthRoleBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "organizationId"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AuthRoleCode"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AuthRoleCode": {
        "type": "string",
        "enum": [
          "platform_operator",
          "administrator",
          "manager"
        ]
      },
      "AuthSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "issuedAt",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "server"
            ]
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "loggedOut",
          "sessionMode",
          "implementationStage"
        ],
        "properties": {
          "loggedOut": {
            "type": "boolean",
            "const": true
          },
          "sessionMode": {
            "type": "string",
            "enum": [
              "server"
            ]
          },
          "implementationStage": {
            "type": "string",
            "enum": [
              "M1"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
