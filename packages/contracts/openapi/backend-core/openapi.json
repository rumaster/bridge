{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Backend health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/metrics": {
      "get": {
        "operationId": "HealthController_getMetrics_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition"
          }
        },
        "summary": "Backend metrics skeleton",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Bridge Backend Core API",
    "description": "M0 REST skeleton for C3 backend core contracts.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FacadeStatusDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ai"
          },
          "serviceId": {
            "type": "string",
            "example": "SVC-AI"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock"
            ],
            "example": "mock"
          },
          "status": {
            "type": "string",
            "enum": [
              "degraded"
            ],
            "example": "degraded"
          }
        },
        "required": [
          "name",
          "serviceId",
          "mode",
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "http": {
            "type": "string",
            "example": "ok"
          },
          "facades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacadeStatusDto"
            }
          }
        },
        "required": [
          "http",
          "facades"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "backend"
          },
          "version": {
            "type": "string",
            "example": "0.0.0"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-02T16:00:00.000Z"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp",
          "checks"
        ]
      }
    }
  }
}
