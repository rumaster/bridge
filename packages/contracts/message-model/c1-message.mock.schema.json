{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/c1-message.mock.schema.json",
  "title": "C1 Message Model M0 Mock",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_id",
    "organization_id",
    "channel_id",
    "channel_type",
    "direction",
    "content"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "channel_type": {
      "type": "string",
      "minLength": 1
    },
    "external_message_id": {
      "type": "string"
    },
    "conversation_ref": {
      "type": "string"
    },
    "sender_ref": {
      "type": "string"
    },
    "direction": {
      "enum": ["inbound", "outbound"]
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["text", "image", "file", "voice", "video"]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
