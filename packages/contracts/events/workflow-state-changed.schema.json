{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/contracts/events/workflow-state-changed.schema.json",
  "title": "C7 workflow.state_changed event",
  "x-contract-id": "C7.workflow.state_changed",
  "x-owner": "SVC-FBP",
