      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "created",
        "started",
        "running",
        "waiting",
        "callback_recorded",
        "completed",
        "failed",
        "cancelled",
        "degraded",
        null
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "started",
        "running",
        "waiting",
        "callback_recorded",
        "completed",
        "failed",
        "cancelled",
        "degraded"
      ]
    },
    "changed_at": {
      "type": "string",
