{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge.local/c4-ai-assistant-suggest-response.schema.json",
  "title": "C4 AI Assistant Suggest Response",
  "description": "Frozen C4 assistant response. On CP-3 it carries a RAG answer with Knowledge Base citations; the shape is identical to the M0 mock so consumers are not broken (additive-only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "request_id",
    "organization_id",
    "degraded",
    "fallback_reason",
    "suggestion",
    "source_status",
    "sources",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "C4.AssistantSuggestResponse"
    },
    "version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "degraded": {
      "type": "boolean"
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "timeout",
        "unavailable",
        null
      ]
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "text",
        "confidence"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "generated",
            "fallback"
          ]
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source_status": {
      "type": "string",
      "enum": [
        "available",
        "not_available_m0",
        "unavailable"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "title"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "knowledge_chunk",
              "none"
            ]
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
