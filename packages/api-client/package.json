{
  "name": "@bridge/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated/openapi": {
      "types": "./src/generated/openapi.ts",
      "default": "./src/generated/openapi.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "node --import tsx scripts/generate-openapi-client.ts",
    "generate:check": "node --import tsx scripts/generate-openapi-client.ts --check",
    "lint": "npm run generate:check && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "npm run generate:check && tsc -p tsconfig.json"
  }
}
