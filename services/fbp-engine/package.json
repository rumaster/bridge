{
  "name": "@bridge/fbp-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "find src test -name '*.mjs' -print0 | xargs -0 -r -n 1 node --check",
    "test": "node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "build": "find src -name '*.mjs' -print0 | xargs -0 -r -n 1 node --check",
    "start": "node src/main.mjs"
  }
}
