{
  "name": "@bridge/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json && find src test -name '*.mjs' -print0 | xargs -0 -r -n 1 node --check",
    "test": "jest --config jest.config.cjs --runInBand && node --test test/",
    "test:unit": "jest --config jest.config.cjs --runInBand test/unit && node --test test/unit/*.test.mjs",
    "test:integration": "jest --config jest.config.cjs --runInBand test/integration && node --test test/integration/*.test.mjs",
    "build": "tsc -p tsconfig.build.json && node dist/tools/export-openapi.js && find src -name '*.mjs' -print0 | xargs -0 -r -n 1 node --check",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
