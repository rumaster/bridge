# Bridge — переменные окружения для Edge Cluster (РФ)
# (deploy/compose/docker-compose.rf.yml).
#
# Этот файл описывает ОТДЕЛЬНУЮ инфраструктуру, разворачиваемую на сервере,
# физически размещённом в России (152-ФЗ), независимо от Application Cluster
# (.env.example / docker-compose.yml). Скопируйте в .env.rf:
#   cp .env.rf.example .env.rf
#   docker compose --env-file .env.rf -f deploy/compose/docker-compose.rf.yml up --build
#
# RF-first-конвейер Edge (VPN Tunnel Service, шифр RF-буфера, секвенсор порядка,
# оркестратор Edge Cluster) реализован в services/edge-gateway/src (CP-7, ТЗ
# §7.8–§7.10, §7.14) и покрыт unit/integration/contract/e2e-тестами. Секреты ниже
# питают эти модули (VPN-туннель и шифрование payload RF-буфера) и должны
# приходить из централизованного секрет-менеджера (мастер §2), а НЕ коммититься.
# Значения-заглушки здесь только для локальной проверки — замените в проде.

# --- PostgreSQL (резидентный буфер, только для Edge Cluster) ---
POSTGRES_RF_USER=bridge_edge
POSTGRES_RF_PASSWORD=bridge_edge
POSTGRES_RF_DB=bridge_edge
# Порт хоста по умолчанию отличается от Application Cluster (5432), чтобы оба
# кластера можно было при желании поднять на одной машине для локальной
# проверки без конфликта портов.
POSTGRES_RF_PORT=5433

# Строка подключения для миграций RF-контура. Хост "postgres-rf" — имя сервиса
# в сети docker compose, его менять не нужно.
RF_DATABASE_URL=postgres://bridge_edge:bridge_edge@postgres-rf:5432/bridge_edge

# --- edge-gateway (WebSocket-шлюз для клиентов в РФ) ---
EDGE_GATEWAY_MODE=edge
EDGE_GATEWAY_PORT=3000

# --- Канал MAX на Edge (edge-owned, docs/plan/max-channel-production.md) ---
# По требованию «бот max на edge» приём/отправка MAX идут на Edge Gateway (как
# email): getUpdates → RF-first буфер → туннель → ядро; ответ менеджера →
# egress_dispatch → MAX Bot API на Edge. Токен бота организации приходит с
# App-стороны через control-plane (channel_credentials_sync) и в коде не хранится.
# Гейт подключения edge-owned канальных драйверов к рантайму (Этап M5). off (по
# умолчанию) — поведение живого edge не меняется; on — Edge поднимает control-plane
# (creds-sync + egress) и входящий MAX-драйвер (getUpdates → RF-first → туннель).
EDGE_CHANNEL_DRIVERS=off
MAX_API_BASE_URL=https://botapi.max.ru
MAX_INBOUND_POLL_TIMEOUT_SECONDS=30
MAX_INBOUND_REFRESH_INTERVAL_MS=30000
# Email-драйверы на Edge (Этап M1, docs/plan/mail-service-selfhosted.md).
# Активируются вместе с EDGE_CHANNEL_DRIVERS=on. Входящее — IMAP poll через
# createImapMailbox (imapflow), исходящее — nodemailer SMTP; реестр каналов и
# креды приходят с App-стороны через control-plane (channel_credentials_sync).
EMAIL_INBOUND_POLL_INTERVAL_MS=15000
EMAIL_INBOUND_REFRESH_INTERVAL_MS=30000
# 0 — принимать self-signed TLS-сертификат почтовика (M1: mailserver в docker-сети
# отдаёт self-signed, имя `mailserver` не совпадает с CN). Для боевых кред — 1.
EMAIL_TLS_REJECT_UNAUTHORIZED=1

# --- Смежная услуга: self-hosted почта (профиль compose `mail`, ---
# --- docs/plan/mail-service-selfhosted.md) ---
# Профиль опционален: без `--profile mail` почтовик не поднимается.
MAIL_IMAGE_TAG=latest
# Почтовый домен ящиков (часть после @). M1: любой (напр. bridge.local); на стенде
# используется реальный домен. Из него строятся адреса ящиков (support@<домен>).
MAIL_DOMAIN=bridge.local
# FQDN сервера. Обычно mail.<MAIL_DOMAIN>; задаётся отдельным значением (вложенная
# подстановка ${..:-mail.${MAIL_DOMAIN}} в compose ненадёжна). M3: A/PTR/MX.
MAIL_HOSTNAME=mail.bridge.local
MAIL_POSTMASTER=postmaster@bridge.local
# M1: антиспам/DKIM/DMARC/fail2ban выключены; SSL_TYPE пуст (self-signed внутри
# docker-сети). M3 (боевая доставка): RSPAMD/OPENDKIM/OPENDMARC/FAIL2BAN=1,
# SSL_TYPE=letsencrypt (см. план §5.M3).
MAIL_ENABLE_RSPAMD=0
MAIL_ENABLE_CLAMAV=0
MAIL_ENABLE_AMAVIS=0
MAIL_ENABLE_OPENDKIM=0
MAIL_ENABLE_OPENDMARC=0
MAIL_ENABLE_FAIL2BAN=0
MAIL_SSL_TYPE=
MAIL_PERMIT_DOCKER=connected-networks
MAIL_LOG_LEVEL=info
# Host-порты для отладки со стенда (высокие, чтобы не конфликтовать). edge-gateway
# всё равно ходит по имени mailserver внутри docker-сети. M1 без SSL_TYPE — только
# STARTTLS-порты: 587 (submission) и 143 (IMAP); 993/465 требуют SSL_TYPE (M3).
MAIL_SMTP_HOST_PORT=1587
MAIL_IMAP_HOST_PORT=1143

# --- Секреты RF-first-конвейера (через секрет-менеджер, НЕ в коде) ---
# Ключ шифрования payload RF-буфера (edge_message_buffer.payload_encrypted,
# AES-256-GCM): base64/hex/utf8, декодируется ровно в 32 байта. Потребитель —
# resolveRfPayloadKey (services/edge-gateway/src/rf-payload-cipher.ts).
EDGE_BUFFER_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key
# Pre-shared секрет VPN Tunnel Service (Edge↔App, HKDF-SHA256 → сеансовый ключ):
# base64/hex/utf8, не короче 16 байт (рекомендуется 32). Потребитель —
# resolveVpnSessionSecret (services/edge-gateway/src/vpn-tunnel.ts). Значение
# ДОЛЖНО совпадать с App-стороной VPN-туннеля в Application Cluster.
EDGE_VPN_SESSION_KEY=change-me-to-a-base64-encoded-32-byte-secret

# Идентичность RF-стороны туннеля и доверие к App-стороне. Это app-level
# mTLS-проверка внутри VPN Tunnel Service; значения должны приходить из
# секрет-менеджера и совпадать с Application Cluster.
EDGE_VPN_EDGE_ID=edge-rf
EDGE_VPN_EDGE_CERT=edge-rf-cert-fingerprint
EDGE_VPN_TRUSTED_APP_CERTS=app-core-cert-fingerprint

# App-сторона VPN Tunnel Service из Application Cluster. Основной путь —
# TCP/TLS socket, fallback — WSS/WS с тем же EDGE_VPN_SESSION_KEY.
# Для локального стенда без TLS можно использовать tcp://... и ws://..., для
# production — tcps://... и wss://... с TLS-терминацией.
#
# С AmneziaWG-туннелем (профиль compose `tunnel`, Этап 1, issue #257) этот адрес
# перенастраивается на ТУННЕЛЬНЫЙ IP App-стороны — awg-keygen.sh кладёт
# EDGE_VPN_APP_TCP_URL=tcp://10.7.0.1:3049 в .env.awg.rf.
EDGE_VPN_APP_TCP_URL=tcp://app.cluster.example:3049
EDGE_VPN_APP_WSS_URL=wss://app.cluster.example:3050/vpn

# --- AmneziaWG туннель, Edge-сторона / awg-client (issue #257, Этап 1) ---
# Активируется профилем compose `tunnel`. awg-client поднимает awg0 (10.7.0.2)
# внутри network namespace edge-gateway и инициирует хендшейк к AWG_ENDPOINT.
# Ключи/PSK/H1–H4 генерируются deploy/compose/awg-keygen.sh → .env.awg.rf
# (НЕ в git); ниже — только структура. S1/S2/H1–H4 ОБЯЗАНЫ совпадать с .env (App).
AWG_MTU=1380
# AWG_CLIENT_PRIVATE_KEY=<awg genkey>            # приватный ключ Edge-стороны
# AWG_SERVER_PUBLIC_KEY=<awg pubkey App>         # публичный ключ App-стороны
# AWG_PRESHARED_KEY=<awg genpsk>                 # = App-стороне
# AWG_ENDPOINT=app.cluster.example:51820         # публичный UDP-эндпоинт App
# AWG_PERSISTENT_KEEPALIVE=25
# AWG_JC=6  AWG_JMIN=40  AWG_JMAX=70            # junk — только на клиенте
# AWG_S1=0  AWG_S2=0
# AWG_H1=  AWG_H2=  AWG_H3=  AWG_H4=             # общий профиль, = App-стороне
EDGE_VPN_TIMEOUT_MS=5000
EDGE_VPN_BACKOFF_MS=100,500,1000,2500,5000
EDGE_BUFFER_TTL_MS=3600000

# TLS trust/options для RF-клиента при tcps:// и wss:// с private CA или
# взаимной TLS-аутентификацией на транспортном уровне.
EDGE_VPN_APP_TCP_CLIENT_TLS_CA=
EDGE_VPN_APP_TCP_CLIENT_TLS_KEY=
EDGE_VPN_APP_TCP_CLIENT_TLS_CERT=
EDGE_VPN_APP_WSS_CLIENT_TLS_CA=
EDGE_VPN_APP_WSS_CLIENT_TLS_KEY=
EDGE_VPN_APP_WSS_CLIENT_TLS_CERT=
