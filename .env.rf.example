# Bridge — переменные окружения для Edge Cluster (РФ)
# (deploy/compose/docker-compose.rf.yml).
#
# Этот файл описывает ОТДЕЛЬНУЮ инфраструктуру, разворачиваемую на сервере,
# физически размещённом в России (152-ФЗ), независимо от Application Cluster
# (.env.example / docker-compose.yml). Скопируйте в .env.rf:
#   cp .env.rf.example .env.rf
#   docker compose --env-file .env.rf -f deploy/compose/docker-compose.rf.yml up --build
#
# RF-first-конвейер Edge (VPN Tunnel Service, шифр RF-буфера, секвенсор порядка,
# оркестратор Edge Cluster) реализован в services/edge-gateway/src (CP-7, ТЗ
# §7.8–§7.10, §7.14) и покрыт unit/integration/contract/e2e-тестами. Секреты ниже
# питают эти модули (VPN-туннель и шифрование payload RF-буфера) и должны
# приходить из централизованного секрет-менеджера (мастер §2), а НЕ коммититься.
# Значения-заглушки здесь только для локальной проверки — замените в проде.

# --- PostgreSQL (резидентный буфер, только для Edge Cluster) ---
POSTGRES_RF_USER=bridge_edge
POSTGRES_RF_PASSWORD=bridge_edge
POSTGRES_RF_DB=bridge_edge
# Порт хоста по умолчанию отличается от Application Cluster (5432), чтобы оба
# кластера можно было при желании поднять на одной машине для локальной
# проверки без конфликта портов.
POSTGRES_RF_PORT=5433

# Строка подключения для миграций RF-контура. Хост "postgres-rf" — имя сервиса
# в сети docker compose, его менять не нужно.
RF_DATABASE_URL=postgres://bridge_edge:bridge_edge@postgres-rf:5432/bridge_edge

# --- edge-gateway (WebSocket-шлюз для клиентов в РФ) ---
EDGE_GATEWAY_PORT=3000

# --- Секреты RF-first-конвейера (через секрет-менеджер, НЕ в коде) ---
# Ключ шифрования payload RF-буфера (edge_message_buffer.payload_encrypted,
# AES-256-GCM): base64/hex/utf8, декодируется ровно в 32 байта. Потребитель —
# resolveRfPayloadKey (services/edge-gateway/src/rf-payload-cipher.mjs).
EDGE_BUFFER_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key
# Pre-shared секрет VPN Tunnel Service (Edge↔App, HKDF-SHA256 → сеансовый ключ):
# base64/hex/utf8, не короче 16 байт (рекомендуется 32). Потребитель —
# resolveVpnSessionSecret (services/edge-gateway/src/vpn-tunnel.mjs). Значение
# ДОЛЖНО совпадать с App-стороной VPN-туннеля в Application Cluster.
EDGE_VPN_SESSION_KEY=change-me-to-a-base64-encoded-32-byte-secret
