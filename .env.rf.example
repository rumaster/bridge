# Bridge — переменные окружения для Edge Cluster (РФ)
# (deploy/compose/docker-compose.rf.yml).
#
# Этот файл описывает ОТДЕЛЬНУЮ инфраструктуру, разворачиваемую на сервере,
# физически размещённом в России (152-ФЗ), независимо от Application Cluster
# (.env.example / docker-compose.yml). Скопируйте в .env.rf:
#   cp .env.rf.example .env.rf
#   docker compose --env-file .env.rf -f deploy/compose/docker-compose.rf.yml up --build
#
# VPN Tunnel Service, соединяющий Edge Cluster с Application Cluster, здесь
# не настраивается — на данный момент это компонент этапа M4 без реализации
# в коде (см. комментарий в docker-compose.rf.yml).

# --- PostgreSQL (резидентный буфер, только для Edge Cluster) ---
POSTGRES_RF_USER=bridge_edge
POSTGRES_RF_PASSWORD=bridge_edge
POSTGRES_RF_DB=bridge_edge
# Порт хоста по умолчанию отличается от Application Cluster (5432), чтобы оба
# кластера можно было при желании поднять на одной машине для локальной
# проверки без конфликта портов.
POSTGRES_RF_PORT=5433

# Строка подключения для миграций RF-контура. Хост "postgres-rf" — имя сервиса
# в сети docker compose, его менять не нужно.
RF_DATABASE_URL=postgres://bridge_edge:bridge_edge@postgres-rf:5432/bridge_edge

# --- edge-gateway (WebSocket-шлюз для клиентов в РФ) ---
EDGE_GATEWAY_PORT=3000
